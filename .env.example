# Copy this file to server/.env for local backend development.
# Keep real keys in .env; never commit them.
PORT=3002
FRONTEND_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/clinicprep?retryWrites=true&w=majority
GROQ_API_KEY=replace-with-your-groq-api-key

